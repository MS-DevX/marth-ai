# Optional overrides. Copy to .env and uncomment what you need.
# .env is gitignored; never commit a real secret.
#
# No API key is required: the agent talks to a local Ollama server. If you
# repoint it at a cloud endpoint, that one needs OPENAI_API_KEY below.

# The model to run. `marth --setup` writes this for you.
# AGENT_MODEL=granite4.1:8b

# AGENT_MAX_STEPS=20
# AGENT_COMMAND_TIMEOUT=30
# AGENT_MAX_OUTPUT_CHARS=4000
# AGENT_MAX_FILE_BYTES=512000
# AGENT_WORKSPACE=/path/to/the/repo/you/want/to/work/on
# (defaults to this project directory)

# Where the model is served from. The default is a local Ollama server.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AGENT_CONTEXT_TOKENS=8192
# AGENT_THINKING=0
# AGENT_TIMEOUT=300
# AGENT_MAX_RETRIES=5
# AGENT_MAX_RETRY_WAIT=60
