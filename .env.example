# Copy this file to .env and fill in your real key.
# .env is gitignored; never commit a real key.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown).
# AGENT_PROVIDER=gemini        # or "openai" for Ollama / Groq / OpenRouter
# AGENT_MODEL=gemini-3.5-flash
# AGENT_MAX_STEPS=20
# AGENT_COMMAND_TIMEOUT=30
# AGENT_MAX_OUTPUT_CHARS=4000
# AGENT_MAX_FILE_BYTES=512000
# AGENT_WORKSPACE=/path/to/the/repo/you/want/to/work/on
# (defaults to this project directory)

# Local model, used when AGENT_PROVIDER=openai.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AGENT_CONTEXT_TOKENS=8192
# AGENT_THINKING=0
# AGENT_TIMEOUT=300
# AGENT_MAX_RETRIES=5
# AGENT_MAX_RETRY_WAIT=60
